{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://st-cloud.local/schema/loop-state.schema.json",
  "title": "Agent Loop V2 State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "definitionVersion", "taskId", "scale", "status", "goal", "revision", "exitCriteria", "artifacts", "blockers", "acceptanceEvidence", "dispatchLedger", "history"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "definitionVersion": { "const": 2 },
    "legacy": { "type": "boolean" },
    "taskId": { "type": "string", "minLength": 1 },
    "scale": { "enum": ["small", "medium", "large"] },
    "status": { "enum": ["running", "blocked_escalation", "done", "incomplete", "abandoned"] },
    "goal": {
      "type": "object",
      "additionalProperties": true,
      "required": ["objective", "scope", "completionCriteria"],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "scope": {},
        "completionCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "code"],
      "properties": {
        "design": { "type": ["string", "null"] },
        "code": { "type": ["string", "null"] }
      }
    },
    "exitCriteria": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "artifacts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/artifact" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "acceptanceEvidence": { "type": "array", "items": { "$ref": "#/$defs/acceptance" } },
    "dispatchLedger": { "type": "array", "items": { "$ref": "#/$defs/dispatchAttempt" } },
    "singleAgentAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "actor", "authorizedBy", "authorizationQuote", "evidenceRef", "criteria"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "authorizedBy": { "const": "user" },
        "authorizationQuote": { "type": "string", "minLength": 1 },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["CODE_REVIEW", "SECURITY_REVIEW", "EXP_ACCEPT", "TEST_PASS", "ACCEPT"] } }
      }
    },
    "proposals": { "type": "array", "items": { "type": "object" } },
    "history": { "type": "array", "items": { "$ref": "#/$defs/history" } }
  },
  "$defs": {
    "dispatchAttempt": {
      "type": "object",
      "additionalProperties": true,
      "required": ["dispatchId", "taskId", "idempotencyKey", "role", "taskType", "criterionId", "childId", "status"],
      "properties": {
        "dispatchId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "role": { "enum": ["executor", "reviewer", "tester"] },
        "taskType": { "type": "string", "minLength": 1 },
        "criterionId": { "type": "string", "minLength": 1 },
        "childId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "spawned", "acked", "running", "returned", "evaluated", "failed"] },
        "resultRef": { "type": "string", "minLength": 1 },
        "scopeVerified": { "type": "boolean" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "dependsOn"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
        "status": { "enum": ["pending", "in_progress", "done", "stale", "blocked", "skipped"] },
        "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "applicable": { "type": "boolean" },
        "confirmationRequired": { "type": "boolean" },
        "by": { "type": "string", "minLength": 1 },
        "dispatchId": { "type": "string", "minLength": 1 },
        "executionKind": { "enum": ["direct", "dispatch"] },
        "executionId": { "type": "string", "minLength": 1 },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "validatedRevision": { "type": "string", "minLength": 1 },
        "completedAt": { "type": "string", "format": "date-time" },
        "skipReason": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "userConfirmedAt": { "type": "string", "format": "date-time" },
        "confirmedBy": { "type": "string", "minLength": 1 },
        "confirmationArtifact": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "ready", "done", "missing", "stale", "skipped"] },
        "ref": { "type": "string" },
        "provides": { "type": "array", "items": { "type": "string" } },
        "userConfirmedAt": { "type": ["string", "null"], "format": "date-time" },
        "confirmedBy": { "type": ["string", "null"] }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fingerprint", "status", "repairAttempts"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved", "escalated"] },
        "repairAttempts": { "type": "array" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "evidenceRef", "validatedRevision"],
      "properties": {
        "criterion": { "type": "string", "minLength": 1 },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "validatedRevision": { "type": "string", "minLength": 1 }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": true,
      "required": ["eventId", "action", "actor", "occurredAt", "revision"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "revision": { "type": "object" }
      }
    }
  }
}
