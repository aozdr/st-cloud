# ============================================================
# 星云盘 环境变量示例
# 用法：cd docker && cp .env.example .env，按需修改
# docker-compose 自动加载同目录 .env；后端进程（mvn/IDE）自行注入环境变量
# ============================================================

# MySQL root 密码（docker-compose 使用；开发默认 123456，生产必改）
MYSQL_ROOT_PASSWORD=123456

# JWT 主密钥：用于加解密数据库中的签名密钥（至少 32 字节；生产必改）
STCLOUD_MASTER_KEY=change-me-master-key-at-least-32-bytes

# S3 兼容对象存储（RustFS / MinIO）凭证
STCLOUD_S3_ACCESS_KEY=stcloud
STCLOUD_S3_SECRET_KEY=stcloud123

# OnlyOffice 签名密钥（HS256 至少 32 字节；docker-compose 与后端共用，生产必改）
STCLOUD_ONLYOFFICE_SECRET=stcloud-onlyoffice-dev-secret-0123456789
