# ============================================================
# 星云盘 环境变量示例
# 用法：cd docker && cp .env.example .env，按需修改
# docker-compose 自动加载同目录 .env；后端进程（mvn/IDE）自行注入环境变量
# ============================================================

# MySQL root 密码（docker-compose 使用；开发默认 123456，生产必改）
MYSQL_ROOT_PASSWORD=123456

# 后端开发数据库；未配置 STCLOUD_MYSQL_PASSWORD 时复用 MYSQL_ROOT_PASSWORD
# STCLOUD_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/stcloud?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# STCLOUD_MYSQL_USER=root
# STCLOUD_MYSQL_PASSWORD=123456

# 本机已核验 ES 8.12.0 + IK 镜像默认锁定本地产物，不能从远程拉取。
# 新机器：docker build -t stcloud-elasticsearch:8.12.0 ./elasticsearch
# 构建/插件核验后，改为自己的固定镜像引用（生产使用已发布的仓库 digest）。
# STCLOUD_ELASTICSEARCH_IMAGE=stcloud-elasticsearch:8.12.0

# 启动后端前：powershell -File ./scripts/Test-Dependencies.ps1
# 真实 MQ 收发与 S3 读写（专用随机测试资源保留审计）：加 -WriteProbe
# 当前旧 Broker 的 store 没有持久卷，禁止直接 compose up 重建；先备份并迁移消息/位点。
# 新 healthcheck 仅在更新容器后自动运行，现有容器先用上述脚本手动核验。

# JWT 主密钥：用于加解密数据库中的签名密钥（至少 32 字节；生产必改）
STCLOUD_MASTER_KEY=change-me-master-key-at-least-32-bytes

# S3 兼容对象存储（RustFS / MinIO）凭证
STCLOUD_S3_ACCESS_KEY=stcloud
STCLOUD_S3_SECRET_KEY=stcloud123

# 服务端内部读写地址（容器内走服务网络）；不设置时用 application.yml 的 127.0.0.1:9000
# STCLOUD_STORAGE_ENDPOINT=http://rustfs:9000
# 预签名 URL 用于浏览器/客户端直达，必须是客户端可达地址；留空回退 endpoint
# STCLOUD_STORAGE_PUBLIC_ENDPOINT=http://192.168.2.5:9000

# OnlyOffice 签名密钥（HS256 至少 32 字节；docker-compose 与后端共用，生产必改）
STCLOUD_ONLYOFFICE_SECRET=stcloud-onlyoffice-dev-secret-0123456789

# 团队搜索多实例部署时，给所有后端实例配置同一个随机游标签名密钥
# STCLOUD_SEARCH_TEAM_CURSOR_SECRET=replace-with-a-long-random-secret

# ============================================================
# 多节点部署（docker-compose.cluster.yml）
# ============================================================
# 多实例必须用 redis 共享信用桶；单机保持 local
# STCLOUD_RATE_LIMIT_MODE=redis

# cluster 编排读取的预签名地址别名（注入容器内的 STCLOUD_STORAGE_PUBLIC_ENDPOINT）。
# 必须是客户端可达地址；不要用 host.docker.internal（代理/VPN 环境可能不可达）。
# 使用 docker-compose.cluster.yml 时此项必填，缺失会直接报错。
# STCLOUD_PUBLIC_S3_ENDPOINT=http://192.168.2.5:9000

# OnlyOffice 回调与前端访问的入口地址（Nginx）
# STCLOUD_PUBLIC_BASE_URL=http://localhost
